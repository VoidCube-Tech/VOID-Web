---
interface Props { distance: number }
const { distance } = Astro.props;
---

<div data-hero-scroll style={`--hero-distance: ${Math.max(0, distance)}svh`}>
	<!-- Pin the continuous content flow so the next section stays beside the Hero. -->
	<div data-hero-stage><slot /></div>
</div>

<style>
	[data-hero-scroll] { position: relative; overflow-anchor: none; }
	[data-hero-stage] { display: flow-root; }
	@media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
		[data-hero-scroll] { height: calc(var(--hero-stage-height) + var(--hero-distance)); }
		[data-hero-stage] { position: sticky; top: 0; }
	}
</style>

<script is:inline>
	(() => {
		const track = document.currentScript.previousElementSibling;
		const stage = track.querySelector('[data-hero-stage]');
		const enabled = matchMedia('(min-width: 768px) and (prefers-reduced-motion: no-preference)');
		let distance = 0;
		let start = 0;
		let previousScroll = scrollY;
		let progress = 0;
		let wasEnabled = enabled.matches;
		const measure = (preserve = false) => {
			const oldDistance = distance;
			const oldStart = start;
			const oldScroll = previousScroll;
			const oldProgress = progress;
			track.style.setProperty('--hero-stage-height', `${stage.getBoundingClientRect().height}px`);
			start = track.getBoundingClientRect().top + scrollY;
			distance = enabled.matches ? Math.max(0, track.offsetHeight - stage.offsetHeight) : 0;
			// Remap the native scroll coordinate after resizing, retaining the same
			// timeline position (or the same distance into the following content).
			if (preserve && wasEnabled && enabled.matches && oldDistance > 0 && oldScroll >= oldStart) {
				const next = oldProgress < 1
					? start + oldProgress * distance
					: start + distance + oldScroll - oldStart - oldDistance;
				window.scrollTo({ top: next, behavior: 'instant' });
			} else if (preserve && wasEnabled !== enabled.matches && oldScroll >= oldStart) {
				const offset = Math.max(0, oldScroll - oldStart - oldDistance);
				window.scrollTo({ top: start + (enabled.matches ? distance * progress : 0) + offset, behavior: 'instant' });
			}
			wasEnabled = enabled.matches;
			previousScroll = scrollY;
			if (enabled.matches) progress = distance > 0 ? Math.min(1, Math.max(0, (scrollY - start) / distance)) : 1;
			track.dispatchEvent(new Event('hero-measure'));
		};
		window.addEventListener('scroll', () => {
			previousScroll = scrollY;
			if (enabled.matches) progress = distance > 0 ? Math.min(1, Math.max(0, (scrollY - start) / distance)) : 1;
		}, { passive: true });
		window.addEventListener('resize', () => measure(true), { passive: true });
		window.addEventListener('pageshow', () => measure());
		enabled.addEventListener('change', () => measure(true));
		new ResizeObserver(() => measure()).observe(stage);
		measure();
	})();
</script>
