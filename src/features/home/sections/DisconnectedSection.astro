---
import type { HomeContent } from "../content/homeContent";
interface Props {
    readonly content: HomeContent["disconnected"];
}
const { content } = Astro.props;
---

<section
    id="disconnected"
    aria-labelledby="disconnected-title"
    class="relative mx-auto w-full max-w-6xl px-6 pt-36 pb-32 text-on-surface sm:px-10 sm:pt-44 sm:pb-40 lg:pt-64 lg:pb-48"
>
    <div class="h-16"></div>
    <p class="text-sm font-bold uppercase tracking-widest text-primary">
        {content.eyebrow}
    </p>
    <h2
        id="disconnected-title"
        class="mt-4 max-w-4xl font-secondary text-3xl leading-tight sm:text-5xl"
    >
        {content.title}
    </h2>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-on-surface-variant">
        {content.description}
    </p>
    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-4">
        {
            content.items.map((item) => (
                <li class="border-b border-outline/30 py-4 text-lg">{item}</li>
            ))
        }
    </ul>
</section>
