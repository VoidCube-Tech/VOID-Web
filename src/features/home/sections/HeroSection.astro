---
import { Hero } from "../components/Hero";
import HeroScroll from "../components/HeroScroll.astro";
import type { HeroAnimation } from "../components/heroAnimation";
import type { HeroMedia } from "../components/heroMedia";
import type { HomeContent } from "../content/homeContent";
interface Props { readonly content: HomeContent["hero"] }
const { content } = Astro.props;
const media: HeroMedia = {
	mobile: "/assets/videos/cube_hole_720p.webm",
	desktop: "/assets/videos/cube_hole_4k.webm",
	tv: "/assets/videos/cube_hole_4k.webm",
};

const animation: HeroAnimation = {
	content: {
		revealAt: 0.82,
		offsetY: 0,
		easing: "smooth",
		heightVh: 90,
		x: 5,
		y: 25,
		mobileHeightVh: 95,
		mobileX: 0,
		mobileY: 10,
	},
	desktop: {
		scrollHeight: 400,
		startScale: 0.3,
		zoomScale: 0.65,
		endScale: 0.65,
		endX: 42,
		endY: 0,
		startRotation: -2,
		zoomRotation: 0,
		endRotation: 2,
		finalRotationAt: 0.5,
		finalRotation: 20,
		zoomAt: 0.35,
		smoothing: 10,
		easing: "smooth",
	},
	mobile: {
		initialScale: 1,
		finalScale: 0.55,
		finalY: 20,
		initialRotation: -1,
		finalRotation: 1,
		duration: 1200,
		easing: "smooth",
		fit: "contain",
	},
};
---
<HeroScroll distance={animation.desktop.scrollHeight ?? 300}>
 <Hero client:load media={media} animation={animation} {...content} />
 <!-- Keep the following section in the sticky stage for the existing cloud transition. -->
 <slot />
</HeroScroll>
