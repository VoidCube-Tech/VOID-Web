---
import { CloudSection } from "../components/CloudSection";
import type { HomeContent } from "../content/homeContent";
interface Props { readonly content: HomeContent["problem"] }
const { content } = Astro.props;
---
<CloudSection client:load height="auto" style={{ minHeight: "40vh" }}
 fillColor="#6086a4" cloudColor="#6086a4" secondaryColor="#9265a6"
 blur={12} density={0.7} softness={0.65} edgeNoise={0.65}
 dispersion={{ top: true, bottom: true }} dispersionSize={{ top: 120, bottom: 160 }}>
 <div id="problem" class="relative mx-auto max-w-6xl px-6 py-20 text-surface sm:px-10">
  <p class="text-sm font-bold uppercase tracking-widest">{content.eyebrow}</p>
  <h2 class="mt-4 max-w-3xl font-secondary text-3xl leading-tight sm:text-5xl">{content.title}</h2>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed">{content.description}</p>
  <div class="mt-10 grid grid-cols-1 gap-5 lg:grid-cols-3">
   {content.items.map((item, index) => (
    <article class="rounded-ui border border-surface/20 bg-on-surface/15 p-5 md:p-8">
     <span aria-hidden="true" class="font-mono text-sm tabular-nums">{String(index + 1).padStart(2, "0")}</span>
     <h3 class="mt-4 font-secondary text-2xl leading-tight md:mt-6">{item.title}</h3>
     <p class="mt-3 text-base leading-relaxed md:hidden">{item.mobileDescription}</p>
     <p class="mt-4 hidden text-base leading-relaxed md:block">{item.description}</p>
    </article>
   ))}
  </div>
 </div>
</CloudSection>
