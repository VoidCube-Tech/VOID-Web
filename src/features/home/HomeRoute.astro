---
import { defaultLocale, locales, type Locale } from "../../i18n/config";
import SiteLayout from "../../layouts/SiteLayout.astro";
import HomePage from "./HomePage.astro";
import { homeContent } from "./content/homeContent";
import { getLocalizedPath } from "../navigation/routing/localePath";

interface Props {
	readonly locale: Locale;
}

const { locale } = Astro.props;
const content = homeContent[locale];
const site = Astro.site;
const alternates = site
	? [
		...locales.map((language) => ({
			hreflang: language,
			href: new URL(getLocalizedPath("/", language), site),
		})),
		{
			hreflang: "x-default",
			href: new URL(getLocalizedPath("/", defaultLocale), site),
		},
	]
	: [];
---

<SiteLayout
	lang={locale}
	title={`VoidCube`}
	description={content.hero.description}
	robots="index, follow, max-image-preview:large"
	alternates={alternates}
	socialLocale={locale === "pt-BR" ? "pt_BR" : undefined}
>
	<div class="home-shell">
		<div class="home-content">
			<HomePage locale={locale} />
		</div>
	</div>
</SiteLayout>

<style>
	.home-shell {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
	}

	.home-content {
		position: relative;
		z-index: 1;
	}
</style>
