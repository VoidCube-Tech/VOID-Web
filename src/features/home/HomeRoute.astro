---
import type { Locale } from "../../i18n/config";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { Header } from "../navigation/components/Header";
import { navigationContent } from "../navigation/content";
import HomePage from "./HomePage.astro";
import HomeSpaceBackground from "./components/HomeSpaceBackground.astro";

interface Props {
	readonly locale: Locale;
}

const { locale } = Astro.props;
---

<SiteLayout lang={locale} title="Astro">
	<div class="home-shell">
		<HomeSpaceBackground />
		<div class="home-content">
			<Header client:load content={navigationContent[locale]} currentPath={`${Astro.url.pathname}${Astro.url.search}`} locale={locale} />
			<HomePage locale={locale} />
		</div>
	</div>
</SiteLayout>

<style>
	.home-shell {
		position: relative;
		isolation: isolate;
		min-height: 100svh;
	}

	.home-content {
		position: relative;
		z-index: 1;
	}
</style>
