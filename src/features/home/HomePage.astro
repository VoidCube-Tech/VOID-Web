---
import type { Locale } from "../../i18n/config";
import { homeContent } from "./content/homeContent";
import NebulaArea from "./components/NebulaArea.astro";
import HeroSection from "./sections/HeroSection.astro";
import ProblemSection from "./sections/ProblemSection.astro";
import DisconnectedSection from "./sections/DisconnectedSection.astro";
import SolutionSection from "./sections/SolutionSection.astro";
import ResultsSection from "./sections/ResultsSection.astro";
import ApproachSection from "./sections/ApproachSection.astro";
import DifferentialsSection from "./sections/DifferentialsSection.astro";
import ProcessSection from "./sections/ProcessSection.astro";
import FinalCTASection from "./sections/FinalCTASection.astro";
import RevealOnView from "../../shared/motion/RevealOnView.astro";
interface Props {
	readonly locale: Locale;
}
const { locale } = Astro.props;
const content = homeContent[locale];
---

<main>
	<RevealOnView />
	<HeroSection content={content.hero}>
		<ProblemSection content={content.problem} />
	</HeroSection>
	<DisconnectedSection content={content.disconnected} />
	<SolutionSection content={content.solution} />
	<ResultsSection content={content.results} />
	<NebulaArea>
		<ApproachSection content={content.approach} />
		<DifferentialsSection content={content.differentials} />
	</NebulaArea>
	<ProcessSection content={content.process} />
	<FinalCTASection content={content.finalCta} locale={locale} />
</main>
