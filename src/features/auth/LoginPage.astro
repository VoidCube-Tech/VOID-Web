---

import type { Locale } from "../../i18n/config";
import { getLocalizedPath } from "../navigation/routing/localePath";
import { authContent } from "./content";
import { LogoIcon } from "../navigation/components/LogoIcon";
import { LoginForm } from "./components/LoginForm";
import SpaceBackground from "../../shared/effects/SpaceBackground.astro";
import DocumentLayout from "../../layouts/DocumentLayout.astro";
interface Props {
  readonly locale: Locale;
}
const { locale } = Astro.props;
const content = authContent[locale];
---

<DocumentLayout
    lang={locale}
    bodyClass="bg-background font-primary text-on-surface"
    title={`${content.title}`}
    description={content.description}
    robots="noindex, follow"
    generator={null}
    socialLocale={locale === "pt-BR" ? "pt_BR" : undefined}
>
    <SpaceBackground
      variant="auth"
      stars={{ density: 3, movement: true, speed: .35, directionX: .8, directionY: -.35, rotationSpeed: .08 }}
      nebula={{ movement: true, speed: .85 }}
      shootingStars={{ enabled: true, count: 1, speed: 1, mobileCount: 1, continuous: true }}
      asteroids={{ enabled: true, minCount: 1, maxCount: 8, spawnIntervalMin: 2500, spawnIntervalMax: 5000, lifetimeMin: 20000, lifetimeMax: 36000, sizeMin: 16, sizeMax: 96 }}
    />
    <div
      class="relative isolate flex min-h-svh flex-col lg:h-svh lg:overflow-hidden"
    >
      <main class="relative grid flex-1 lg:min-h-0 lg:grid-cols-2">
        <div
          aria-hidden="true"
          class="auth-void-transition pointer-events-none absolute inset-y-0 left-1/2 hidden w-1/6 bg-[radial-gradient(ellipse_85%_62%_at_0%_26%,color-mix(in_srgb,var(--color-surface-container-lowest)_85%,var(--color-surface-container-low))_0%,color-mix(in_srgb,var(--color-surface-container-lowest)_35%,transparent)_25%,color-mix(in_srgb,var(--color-surface-container-lowest)_8%,transparent)_58%,transparent_100%),radial-gradient(ellipse_68%_80%_at_0%_88%,color-mix(in_srgb,var(--color-surface-container-lowest)_58%,transparent)_0%,color-mix(in_srgb,var(--color-surface-container-lowest)_20%,transparent)_34%,transparent_100%),linear-gradient(to_right,color-mix(in_srgb,var(--color-surface-container-lowest)_85%,var(--color-surface-container-low))_0%_5%,color-mix(in_srgb,var(--color-surface-container-lowest)_35%,transparent)_16%,color-mix(in_srgb,var(--color-surface-container-lowest)_12%,transparent)_35%,transparent_72%)] lg:block"
        >
        </div>
        <div
          class="relative isolate flex items-center justify-center px-6 py-8 sm:px-10 lg:min-h-0 lg:overflow-y-auto lg:px-12"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_85%_90%_at_35%_50%,color-mix(in_srgb,var(--color-surface-container-lowest)_85%,var(--color-surface-container-low))_0%,color-mix(in_srgb,var(--color-surface-container-lowest)_82%,transparent)_42%,color-mix(in_srgb,var(--color-surface-container-lowest)_24%,transparent)_72%,transparent_100%),linear-gradient(to_right,color-mix(in_srgb,var(--color-surface-container-lowest)_45%,transparent),transparent)] lg:bg-none lg:bg-[color-mix(in_srgb,var(--color-surface-container-lowest)_85%,var(--color-surface-container-low))]"
          >
          </div>
          <div class="relative z-10 my-auto w-full max-w-md">
            <a
              href={getLocalizedPath("/", locale)}
              class="inline-flex min-h-10 items-center gap-2 rounded-ui text-sm text-on-surface-variant transition-colors duration-ui ease-ui hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary motion-reduce:transition-none"
              >
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                  class="size-4 fill-none stroke-current"
                  stroke-width="1.5"
                  ><path d="m14 6-6 6 6 6M8 12h12"></path></svg
                >
                {content.back}
              </a>
            <div class="mb-4 flex flex-col items-center gap-2">
              
              <div class="h-20"><LogoIcon /></div>
            </div>
            <LoginForm client:load content={content} contactHref={getLocalizedPath("/contact", locale)} />
          </div>
        </div>
        <div aria-hidden="true" class="hidden lg:block"></div>
      </main>
    </div>
</DocumentLayout>
