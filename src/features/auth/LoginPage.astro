---
import type { Locale } from "../../i18n/config";
import { authContent } from "./content";
import { LoginForm } from "./components/LoginForm";
import AuthBrandVisual from "./components/AuthBrandVisual.astro";
import { liquidGlassAuthStyle } from "../../shared/effects/liquid-glass/liquidGlass";
import "../../shared/effects/liquid-glass/liquidGlass.css";
interface Props { readonly locale: Locale; }
const { locale } = Astro.props;
const content = authContent[locale];
---
<div class="relative isolate overflow-hidden pt-16">
  <main class="relative z-10 mx-auto grid min-h-[calc(100svh-4rem)] max-w-7xl items-center gap-10 px-6 py-10 sm:px-10 lg:grid-cols-5 lg:gap-20 lg:py-16">
    <div class="relative order-2 mx-auto w-full max-w-md lg:order-1 lg:col-span-2">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0">
        <div style={liquidGlassAuthStyle} class="navigation-glass absolute! inset-0 rounded-ui lg:hidden"></div>
        <div style={liquidGlassAuthStyle} class="navigation-glass absolute! inset-y-0 left-0 hidden w-[150%] border-0! [mask-image:url('/assets/masks/auth-glass-warp.svg')] [mask-size:100%_100%] [mask-repeat:no-repeat] lg:block">
          <div class="absolute inset-0 bg-linear-to-br from-on-surface/5 via-transparent to-primary/5"></div>
        </div>
        <svg viewBox="0 0 1500 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false" class="absolute inset-y-0 left-0 hidden h-full w-[150%] fill-none lg:block">
          <defs>
            <linearGradient id="auth-glass-contour" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" class="[stop-color:var(--color-on-surface)] [stop-opacity:.18]" />
              <stop offset=".64" class="[stop-color:var(--color-on-surface)] [stop-opacity:.2]" />
              <stop offset=".74" class="[stop-color:var(--color-primary)] [stop-opacity:.38]" />
              <stop offset="1" class="[stop-color:var(--color-primary)] [stop-opacity:0]" />
            </linearGradient>
          </defs>
          <path d="M24 0 H976 C1010 0 1000 68 1032 145 C1080 270 1148 368 1250 416 C1328 452 1400 452 1500 474 C1380 496 1308 531 1234 587 C1120 672 1065 775 1028 885 C1005 951 1010 1000 976 1000 H24 Q0 1000 0 976 V24 Q0 0 24 0 Z" stroke="url(#auth-glass-contour)" stroke-width="1.25" vector-effect="non-scaling-stroke" />
        </svg>
      </div>
      <LoginForm client:load content={content} />
    </div>
    <AuthBrandVisual />
  </main>
</div>
