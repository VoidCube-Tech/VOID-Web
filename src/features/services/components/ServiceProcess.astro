---
import type { ResolvedSection } from '../resolveServicePageConfig';
interface Props { section: Extract<ResolvedSection, { type: 'process' }> }
const { section } = Astro.props;
---
<section id={section.id} aria-labelledby={`${section.id}-title`} class="py-20 sm:py-32">
  <header class="mb-12 max-w-3xl" data-reveal>
    <h2 id={`${section.id}-title`} class="font-secondary text-4xl leading-tight sm:text-6xl">{section.content.title}</h2>
    {section.content.description && <p class="mt-6 max-w-xl text-lg leading-relaxed text-on-surface-variant">{section.content.description}</p>}
  </header>
  <ol class="grid gap-10 md:grid-cols-2">
    {section.content.items?.map((item, index) => <li class="border-t border-outline-variant/40 pt-6" data-reveal>
      <span class="text-sm text-primary" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <h3 class="mt-4 font-secondary text-3xl">{item.title}</h3>
      <p class="mt-3 max-w-md leading-relaxed text-on-surface-variant">{item.description}</p>
    </li>)}
  </ol>
</section>
