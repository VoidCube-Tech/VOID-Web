---
import type { ResolvedSection } from '../resolveServicePageConfig';
import { liquidGlassSurfaceStyle } from '../../../shared/effects/liquid-glass/liquidGlass';
interface Props { section: Extract<ResolvedSection, { type: 'insight-panel' }> }
const { section } = Astro.props;
const { panel, content, id } = section;
const symbols = { clarity: 'visibility', contact: 'chat_bubble', growth: 'open_in_full' } as const;
---
<section id={id} aria-labelledby={`${id}-title`} class="insight-panel relative min-w-0 pt-16 sm:pt-28">
  <header class="mb-8 w-full max-w-3xl sm:mb-12" data-reveal><h2 id={`${id}-title`} class="font-secondary text-3xl leading-tight sm:text-6xl">{content.title}</h2>{content.description && <p class="mt-6 max-w-xl text-lg leading-relaxed text-on-surface-variant">{content.description}</p>}</header>
  <div class="insight-shell navigation-glass relative w-full min-w-0 rounded-ui border border-outline-variant/40 p-0 sm:p-8" style={{ ...liquidGlassSurfaceStyle, backdropFilter: 'none' }} data-reveal>
    <p class="hidden px-4 py-5 text-sm text-on-surface-variant sm:block sm:mb-8 sm:p-0">{panel.label}</p>
    <div class="grid min-w-0 grid-cols-1 gap-0 sm:gap-8 lg:grid-cols-[1.1fr_1fr] lg:gap-12">
      {panel.research && <article class="insight-research min-w-0 rounded-ui bg-primary-container/20 p-4 sm:p-8" data-reveal>
        <p class="font-secondary text-6xl text-primary sm:text-8xl">{panel.research.value}</p>
        <h3 class="mt-3 max-w-md font-secondary text-lg leading-snug sm:mt-5 sm:text-3xl">{panel.research.statement}</h3>
        <p class="hidden mt-6 text-sm leading-relaxed text-on-surface-variant sm:block">{panel.research.relevance}</p>
        {panel.research.source.shortAttribution && <p class="mt-4 text-xs leading-relaxed text-on-surface-variant sm:hidden">{panel.research.source.shortAttribution}</p>}
        <p class:list={['mt-8 text-xs leading-relaxed text-on-surface-variant', { 'hidden sm:block': !!panel.research.source.shortAttribution }]}>{panel.research.source.context}</p>
        <a href={panel.research.source.href} class="mt-3 inline-flex min-h-10 items-center rounded-ui text-sm text-primary underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">{panel.research.source.label}</a>
      </article>}
      <div class="grid min-w-0 grid-cols-1 gap-4 p-4 sm:gap-6 sm:p-0">{panel.items.map((item, index) => <article class="min-w-0 border-b border-outline-variant/40 pb-4 sm:pb-6 last:border-0" data-reveal data-reveal-delay={String(index + 1)}>
        <div class="mb-2 flex items-start gap-3 sm:mb-3 sm:items-center"><span class="material-symbols-outlined shrink-0 text-primary" aria-hidden="true">{symbols[item.symbol]}</span><h3 class="min-w-0 font-secondary text-lg sm:text-2xl"><span class:list={{ 'hidden sm:inline': !!item.mobile }}>{item.title}</span>{item.mobile && <span class="sm:hidden">{item.mobile.title}</span>}</h3></div>
        <p class:list={['max-w-md text-sm leading-relaxed text-on-surface-variant', { 'hidden sm:block': !!item.mobile }]}>{item.description}</p>
        {item.mobile && <p class="max-w-md text-sm leading-relaxed text-on-surface-variant sm:hidden">{item.mobile.description}</p>}
      </article>)}</div>
    </div>
  </div>
  <div class="insight-bridge relative mx-auto max-w-2xl pb-4 pt-16 text-center sm:pt-20" data-reveal><span class="mx-auto mb-8 block h-16 w-px bg-gradient-to-b from-primary/60 to-primary/10" aria-hidden="true"></span><p class="font-secondary text-3xl leading-snug text-on-surface sm:text-4xl">{panel.bridge}</p></div>
</section>
