---
import type { ServiceConcept } from '../conceptTypes';
import { liquidGlassSurfaceStyle } from '../../../shared/effects/liquid-glass/liquidGlass';
import '../concept.css';
interface Props { demo: ServiceConcept; scene?: 'hero' | 'focus' | 'build' | 'responsive' }
const { demo, scene = 'hero' } = Astro.props;
---
<div class="concept-frame navigation-glass" data-concept-scene={scene} style={{ ...liquidGlassSurfaceStyle, backdropFilter: 'none' }}>
  <div class="concept-chrome flex items-center gap-2 border-b border-outline-variant/40 px-4 py-3" aria-hidden="true">
    <span class="size-2 rounded-full bg-outline/60"></span><span class="size-2 rounded-full bg-outline/40"></span><span class="size-2 rounded-full bg-outline/20"></span>
    <span class="ml-auto h-1 w-1/3 rounded-ui bg-outline-variant/40"></span>
  </div>
  <div class="concept-screen">
    <div class="concept-brand flex items-center justify-between gap-4">
      <span class="text-sm font-bold text-on-surface">{demo.brand}</span>
      <div class="concept-distractions flex gap-2" aria-hidden="true">{demo.distractions.map(text => <span class="rounded-ui border border-outline-variant/50 px-2 py-1 text-xs text-on-surface-variant">{text}</span>)}</div>
    </div>
    <div class="concept-composition">
      <div class="concept-message">
        <h3 class="concept-headline font-secondary leading-tight text-on-surface">{demo.headline}</h3>
        <p class="concept-description mt-4 max-w-xs leading-relaxed text-on-surface-variant">{demo.description}</p>
        <span class="concept-action mt-6 inline-flex min-h-10 items-center justify-center rounded-ui bg-primary px-5 py-3 text-sm font-bold text-on-primary">{demo.action}</span>
      </div>
      <div class="concept-art" aria-hidden="true">
        <svg viewBox="0 0 320 320" class="size-full" fill="none">
          <circle cx="160" cy="160" r="142" class="stroke-outline-variant" />
          <circle cx="160" cy="160" r="110" class="stroke-primary/30" />
          <path d="M160 51 252 106 252 214 160 269 68 214 68 106Z" class="fill-primary-container/30 stroke-primary/60" />
          <path d="M68 106 160 160 252 106M160 160V269M160 51V160" class="stroke-primary/70" />
          <path d="M160 92 216 126 216 194 160 228 104 194 104 126Z" class="fill-surface-container stroke-primary" />
          <path d="M104 126 160 160 216 126M160 160V228" class="stroke-primary" />
          <circle cx="160" cy="160" r="5" class="fill-primary" />
        </svg>
      </div>
    </div>
    <div class="concept-wireframe pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="h-3 w-1/4 rounded-ui bg-outline-variant/60"></div>
      <div class="mt-10 grid grid-cols-2 gap-8"><div class="space-y-4"><div class="h-7 rounded-ui bg-outline-variant/60"></div><div class="h-7 w-2/3 rounded-ui bg-outline-variant/60"></div><div class="h-2 rounded-ui bg-outline-variant/40"></div><div class="h-2 w-3/4 rounded-ui bg-outline-variant/40"></div><div class="mt-8 h-10 w-1/2 rounded-ui border border-outline"></div></div><div class="aspect-square rounded-ui border border-outline-variant"></div></div>
    </div>
  </div>
</div>
