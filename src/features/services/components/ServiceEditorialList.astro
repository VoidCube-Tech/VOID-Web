---
import type { ResolvedSection } from '../resolveServicePageConfig';
interface Props { section: Extract<ResolvedSection, { type: 'editorial-list' }> }
const { section } = Astro.props;
---
<section id={section.id} aria-labelledby={`${section.id}-title`} class="min-w-0 py-16 sm:py-28">
  <h2 id={`${section.id}-title`} class="mb-12 max-w-4xl font-secondary text-4xl leading-tight sm:text-6xl" data-reveal>{section.content.title}</h2>
  {section.content.description && <p class="mb-10 max-w-2xl text-lg leading-relaxed text-on-surface-variant" data-reveal>{section.content.description}</p>}
  <div>{section.content.items?.map((item, index) => <article class="grid gap-3 border-t border-outline-variant/40 py-6 sm:grid-cols-2 sm:gap-12 sm:py-8" data-reveal data-reveal-delay={String(index + 1)}><h3 class="font-secondary text-2xl sm:text-3xl">{item.title}</h3><p class="max-w-xl leading-relaxed text-on-surface-variant">{item.description}</p></article>)}</div>
</section>
