---
import type { ServiceMedia as Media } from '../types';
import ServiceMedia from './ServiceMedia.astro';
interface Props { type: 'carousel' | 'gallery'; items: readonly Media[]; eager?: boolean }
const { type, items, eager = false } = Astro.props;
---
<div tabindex={type === 'carousel' ? 0 : undefined} class:list={[
  'gap-6 focus-visible:outline-2 focus-visible:outline-primary',
  type === 'carousel' ? 'flex overflow-x-auto snap-x snap-mandatory pb-6' : 'grid md:grid-cols-2',
]}>
  {items.map((media, index) => <figure class={type === 'carousel' ? 'w-full shrink-0 snap-center' : ''}><ServiceMedia media={media} eager={eager && index === 0} /></figure>)}
</div>
