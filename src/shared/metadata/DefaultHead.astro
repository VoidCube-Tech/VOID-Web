---
export interface Props {
	readonly title?: string;
	readonly description?: string;
	readonly icon?: string;
	readonly iconType?: string;
	readonly robots?: string;
	readonly generator?: string | null;
	readonly canonical?: string | URL;
	readonly alternates?: readonly {
		readonly hreflang: string;
		readonly href: string | URL;
	}[];
	readonly siteName?: string;
	readonly socialLocale?: string;
	readonly image?: string | URL;
	readonly imageAlt?: string;
}

const {
	siteName = "VoidCube",
	title = siteName,
	description,
	icon = "/favicon.svg",
	iconType = "image/svg+xml",
	robots,
	generator = Astro.generator,
	canonical,
	alternates = [],
	socialLocale,
	image,
	imageAlt,
} = Astro.props;

const canonicalUrl = canonical
	? new URL(canonical, Astro.site)
	: Astro.site
		? new URL(Astro.url.pathname, Astro.site)
		: undefined;
if (canonicalUrl) {
	canonicalUrl.search = "";
	canonicalUrl.hash = "";
}
const imageBase = Astro.site ?? canonicalUrl;
const imageUrl = image && (imageBase || /^https?:\/\//.test(image.toString()))
	? new URL(image, imageBase).href
	: undefined;
---

<head>
	<meta charset="utf-8" />
	<link rel="icon" type={iconType} href={icon} />
	<meta name="viewport" content="width=device-width" />
	{generator != null && <meta name="generator" content={generator} />}
	<title>{title}</title>
	{description !== undefined && <meta name="description" content={description} />}
	{robots !== undefined && <meta name="robots" content={robots} />}
	{canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}
	{alternates.map(({ hreflang, href }) => (
		<link rel="alternate" hreflang={hreflang} href={href.toString()} />
	))}
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content={siteName} />
	<meta property="og:title" content={title} />
	{description !== undefined && <meta property="og:description" content={description} />}
	{canonicalUrl && <meta property="og:url" content={canonicalUrl.href} />}
	{socialLocale && <meta property="og:locale" content={socialLocale} />}
	{imageUrl && <meta property="og:image" content={imageUrl} />}
	{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
	<meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
	<meta name="twitter:title" content={title} />
	{description !== undefined && <meta name="twitter:description" content={description} />}
	{imageUrl && <meta name="twitter:image" content={imageUrl} />}
	{imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
	<slot />
</head>
