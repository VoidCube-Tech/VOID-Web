---
import "./spaceBackground.css";
import type { SpaceBackgroundProps } from "./spaceBackgroundTypes";
import { resolveSpaceBackground, shootingStarAt, spaceBackgroundStyle } from "./spaceBackgroundConfig";
interface Props extends SpaceBackgroundProps {}
const config = resolveSpaceBackground(Astro.props);
const prefix = `space-${crypto.randomUUID()}`;
const asteroidId = `${prefix}-asteroid`;
const shootingStars = config.shootingStars.enabled && !config.shootingStars.continuous ? Array.from({ length: config.shootingStars.count }, (_, index) => shootingStarAt(index)) : [];
---
<svg
  class="home-space-background"
  style={spaceBackgroundStyle(config)}
  data-space-config={(config.asteroids.enabled || (config.shootingStars.enabled && config.shootingStars.continuous)) ? JSON.stringify(config) : undefined}
  data-space-asteroid-id={asteroidId}
  data-star-motion={String(config.stars.movement)}
  data-nebula-motion={String(config.nebula.movement && config.nebula.speed > 0)}
	viewBox="0 0 1600 1000"
	preserveAspectRatio="xMidYMid slice"
	aria-hidden="true"
	focusable="false"
>
	<defs>
		<!-- Fundo espacial -->
		<radialGradient id={`${prefix}-space-base`} cx="50%" cy="28%" r="85%">
			<stop offset="0%" class="space-base-start" />
			<stop offset="55%" class="space-base-middle" />
			<stop offset="100%" class="space-base-end" />
		</radialGradient>

		<!-- Nebulosa principal -->
		<radialGradient id={`${prefix}-nebula-primary`} cx="50%" cy="50%" r="50%">
			<stop offset="0%" class="nebula-primary-core" />
			<stop offset="45%" class="nebula-primary-middle" />
			<stop offset="100%" class="nebula-transparent" />
		</radialGradient>

		<!-- Nebulosa secundária -->
		<radialGradient id={`${prefix}-nebula-tertiary`} cx="50%" cy="50%" r="50%">
			<stop offset="0%" class="nebula-tertiary-core" />
			<stop offset="45%" class="nebula-tertiary-middle" />
			<stop offset="100%" class="nebula-transparent" />
		</radialGradient>

		<!-- Cauda da estrela cadente -->
		<linearGradient id={`${prefix}-shooting-star-tail`} x1="0%" y1="50%" x2="100%" y2="50%">
			<stop offset="0%" class="shooting-tail-start" />
			<stop offset="75%" class="shooting-tail-middle" />
			<stop offset="100%" class="shooting-tail-end" />
		</linearGradient>

		<!-- Campos repetidos aumentam densidade sem centenas de nós SVG. -->
		<pattern id={`${prefix}-star-field-small`} width="360" height="280" patternUnits="userSpaceOnUse" patternTransform={`scale(${1 / Math.sqrt(config.stars.density)})`}>
			<g class="star-field-small">
				<circle cx="18" cy="34" r="0.55" /><circle cx="74" cy="126" r="0.7" />
				<circle cx="118" cy="52" r="0.45" /><circle cx="166" cy="214" r="0.65" />
				<circle cx="205" cy="96" r="0.5" /><circle cx="248" cy="254" r="0.7" />
				<circle cx="292" cy="42" r="0.6" /><circle cx="338" cy="174" r="0.45" />
				<circle cx="42" cy="244" r="0.5" /><circle cx="139" cy="156" r="0.45" />
				<circle cx="226" cy="26" r="0.4" /><circle cx="318" cy="226" r="0.55" />
				<circle cx="270" cy="138" r="0.4" /><circle cx="98" cy="272" r="0.45" />
			</g>
		</pattern>

		<pattern id={`${prefix}-star-field-bright`} width="620" height="460" patternUnits="userSpaceOnUse" patternTransform={`scale(${1 / Math.sqrt(config.stars.density)})`}>
			<g class="star-field-bright">
				<circle cx="52" cy="82" r="0.9" /><circle cx="174" cy="344" r="1.05" />
				<circle cx="286" cy="168" r="0.8" /><circle cx="402" cy="418" r="0.95" />
				<circle cx="508" cy="112" r="1.1" /><circle cx="594" cy="292" r="0.85" />
			</g>
		</pattern>
	    {config.asteroids.enabled && (
      <symbol id={asteroidId} viewBox="0 0 120 100">
        <path d="M14 28 41 8 80 14 108 42 96 79 65 94 27 81 6 55Z" class="fill-surface-container-low stroke-outline-variant" />
        <path d="M14 28 41 8 61 35 36 58 6 55Z" class="fill-surface-variant/60" />
        <path d="M61 35 80 14 108 42 81 57Z" class="fill-outline-variant/40" />
        <path d="M36 58 61 35 81 57 65 94 27 81Z" class="fill-surface-container-high" />
      </symbol>
    )}
  </defs>

	<!-- Fundo -->
	<rect width="1600" height="1000" fill={`url(#${prefix}-space-base)`} />
	<g class="space-star-layer space-star-layer-small"><rect x="-240" y="-240" width="2080" height="1480" fill={`url(#${prefix}-star-field-small)`} /></g>
	<g class="space-star-layer space-star-layer-bright"><rect x="-240" y="-240" width="2080" height="1480" fill={`url(#${prefix}-star-field-bright)`} /></g>

	<!-- Nebulosas -->
	<g class="nebula nebula-primary">
		<ellipse
			cx="260"
			cy="260"
			rx="430"
			ry="240"
			fill={`url(#${prefix}-nebula-primary)`}
		/>
		<ellipse
			cx="500"
			cy="190"
			rx="280"
			ry="150"
			fill={`url(#${prefix}-nebula-primary)`}
			opacity="0.45"
		/>
		<ellipse cx="760" cy="390" rx="350" ry="110" fill={`url(#${prefix}-nebula-primary)`} opacity="0.24" />
	</g>

	<g class="nebula nebula-tertiary">
		<ellipse
			cx="1390"
			cy="730"
			rx="480"
			ry="280"
			fill={`url(#${prefix}-nebula-tertiary)`}
		/>
		<ellipse
			cx="1170"
			cy="820"
			rx="300"
			ry="170"
			fill={`url(#${prefix}-nebula-tertiary)`}
			opacity="0.4"
		/>
		<ellipse cx="920" cy="670" rx="380" ry="125" fill={`url(#${prefix}-nebula-tertiary)`} opacity="0.2" />
	</g>

	<!-- Estrelas -->
	<g class="stars space-star-layer space-star-layer-large">
		<circle cx="92" cy="118" r="1.5" />
		<circle cx="184" cy="430" r="1" opacity="0.52" />
		<circle cx="278" cy="78" r="1" opacity="0.66" />
		<circle cx="356" cy="672" r="1.6" opacity="0.58" />
		<circle cx="442" cy="284" r="0.9" opacity="0.44" />
		<circle cx="530" cy="884" r="1.2" opacity="0.7" />
		<circle cx="618" cy="156" r="1.7" opacity="0.6" />
		<circle cx="704" cy="534" r="1" opacity="0.48" />
		<circle cx="792" cy="92" r="1.1" opacity="0.68" />
		<circle cx="876" cy="758" r="1.5" opacity="0.54" />
		<circle cx="954" cy="348" r="0.9" opacity="0.5" />
		<circle cx="1048" cy="924" r="1.3" opacity="0.64" />
		<circle cx="1136" cy="188" r="1" opacity="0.5" />
		<circle cx="1228" cy="566" r="1.7" opacity="0.62" />
		<circle cx="1316" cy="86" r="1.2" opacity="0.7" />
		<circle cx="1408" cy="806" r="1" opacity="0.48" />
		<circle cx="1512" cy="316" r="1.6" opacity="0.6" />
		<circle cx="146" cy="842" r="0.9" opacity="0.55" />
		<circle cx="672" cy="938" r="0.8" opacity="0.42" />
		<circle cx="1190" cy="408" r="0.8" opacity="0.46" />
		<circle cx="1480" cy="620" r="0.7" opacity="0.38" />
		<circle cx="1010" cy="110" r="0.8" opacity="0.45" />
		<circle cx="370" cy="920" r="0.7" opacity="0.4" />
		<circle cx="820" cy="440" r="0.6" opacity="0.38" />
	</g>

  <!-- One renderer and one keyframe serve every configured shooting star. -->
  {shootingStars.map((star, index) => (
    <g class="shooting-star" data-space-shooting-index={index} data-space-continuous={config.shootingStars.continuous} data-space-mobile-hidden={index >= config.shootingStars.mobileCount} style={{ "--space-shoot-duration": `${star.duration / config.shootingStars.speed}s`, "--space-shoot-delay": `${star.delay / config.shootingStars.speed}s`, "--space-shoot-x": `${star.travelX}px`, "--space-shoot-y": `${star.travelY}px` }}>
      <line x1={star.x} y1={star.y} x2={star.x + star.dx} y2={star.y + star.dy} stroke={`url(#${prefix}-shooting-star-tail)`} stroke-width={star.width} stroke-linecap="round" />
      <circle cx={star.x + star.dx} cy={star.y + star.dy} r={star.radius} class="shooting-head" />
    </g>
  ))}
    {config.shootingStars.enabled && config.shootingStars.continuous && (
    <g data-space-shooting-layer>
      <g data-space-shooting-template visibility="hidden">
        <line stroke={`url(#${prefix}-shooting-star-tail)`} stroke-width="1.5" stroke-linecap="round" />
        <circle r="1.5" class="shooting-head" />
      </g>
    </g>
  )}
  {config.asteroids.enabled && <g data-space-asteroids />}
</svg>
<script>
  import { initSpaceBackgrounds } from "./spaceBackgroundRuntime";
  initSpaceBackgrounds();
</script>
