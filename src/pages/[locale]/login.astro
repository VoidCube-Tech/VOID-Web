---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { authContent } from "../../features/auth/content";
import LoginPage from "../../features/auth/LoginPage.astro";
import { localizedLocales, type Locale } from "../../i18n/config";
export function getStaticPaths() {
  return localizedLocales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
---
<SiteLayout lang={locale} title={`${authContent[locale].title} | VoidCube`}>
  <Fragment slot="head"><meta name="description" content={authContent[locale].description} /><meta name="robots" content="noindex, follow" /></Fragment>
  <LoginPage locale={locale} />
</SiteLayout>

