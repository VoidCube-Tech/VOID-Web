---
import { commercialProducts } from '../../features/catalog/products';
import { defaultLocale } from '../../i18n/config';
import ServiceRoute from '../../features/services/ServiceRoute.astro';
export function getStaticPaths() {
  return commercialProducts.map(product => ({ params: { tag: product.tag }, props: { tag: product.tag } }));
}
const { tag } = Astro.props;
---
<ServiceRoute tag={tag} locale={defaultLocale} />
