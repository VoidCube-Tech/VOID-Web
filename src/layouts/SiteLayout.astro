---
import "../styles/global.css";
import type { Locale } from "../i18n/config";
import Footer from "../features/navigation/components/Footer.astro";
import { Header } from "../features/navigation/components/Header";
import { navigationContent } from "../features/navigation/content";
import SpaceBackground from "../shared/effects/SpaceBackground.astro";

interface Props {
	readonly lang: Locale;
	readonly title: string;
}

const { lang, title } = Astro.props;
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<Header client:load content={navigationContent[lang]} currentPath={`${Astro.url.pathname}${Astro.url.search}`} locale={lang} />
		<SpaceBackground />
		<slot />
		<Footer locale={lang} currentPath={`${Astro.url.pathname}${Astro.url.search}`} />
	</body>
</html>


