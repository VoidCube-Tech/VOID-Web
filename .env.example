# Production origin used for canonical, hreflang and social URLs at build time.
# Set this per project/deployment. Leave empty to omit absolute page URLs.
PUBLIC_SITE_URL=

# Official contact channels. Empty optional channels are not rendered.
# Optional WhatsApp override: international number with country code.
# Empty or invalid override uses the official number in shared/config/contacts.ts.
PUBLIC_WHATSAPP_NUMBER=
PUBLIC_CONTACT_EMAIL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_YOUTUBE_URL=
PUBLIC_LINKEDIN_URL=

